# Docker 服务名称
SERVICE_NAME=traefik
# 服务域名
SERVICE_DOMAIN=traefik.hdyauto.qzz.io
# 使用的应用镜像
DOCKER_IMAGE=traefik:v3.3.3
SERVICE_HTTP_PORT=80
SERVICE_HTTPS_PORT=443
# 示例，使用 CloudFlare 来申请证书
ACME_PROVIDER=cloudflare
# 申请证书要使用的邮箱
ACME_EMAIL=neo991232@gmail.com
# CF DNS API Token
CF_DNS_API_TOKEN=c787dae5bf3dee80c540de19ab6ba7dc55ba4
# DNS Domain (main)
DNS_MAIN=hdyauto.qzz.io
# DNS Domain (list)
DNS_LIST=hdyauto.qzz.io *.hdyauto.qzz.io
